{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starfall.local/protocol/shooter-v2.schema.json",
  "title": "Data-driven Bullet Hell Protocol v2",
  "type": "object",
  "required": ["protocolVersion", "capabilities", "game", "rules", "scoring", "ui", "stages", "dialogues", "players", "enemies", "bosses", "assets"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+[a-z0-9.-]*$" } },
    "game": {
      "type": "object",
      "required": ["id", "title", "version", "defaultPlayer", "entryStage"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "version": { "type": "string" }, "defaultPlayer": { "type": "string" }, "entryStage": { "type": "string" } }
    },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } },
    "players": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/player" } },
    "enemies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/enemy" } },
    "bosses": { "type": "object", "additionalProperties": { "$ref": "#/$defs/boss" } },
    "dialogues": { "type": "object" }, "assets": { "type": "object", "additionalProperties": { "type": "string" } },
    "rules": { "type": "object" }, "scoring": { "type": "object" }, "ui": { "type": "object" }, "persistence": { "type": "object" }, "runtime": { "type": "object" }
  },
  "$defs": {
    "pattern": {
      "type": "object", "required": ["type", "intervalMs", "bulletSpeed", "count", "color"],
      "properties": { "type": { "enum": ["radial", "aimed", "fan", "spiral", "rain"] }, "intervalMs": { "type": "number", "minimum": 40 }, "bulletSpeed": { "type": "number", "exclusiveMinimum": 0 }, "count": { "type": "integer", "minimum": 1, "maximum": 96 }, "color": { "type": "string" } }
    },
    "movement": {
      "oneOf": [
        { "type": "object", "required": ["type", "velocityY"], "properties": { "type": { "const": "linear" }, "velocityX": { "type": "number" }, "velocityY": { "type": "number" } } },
        { "type": "object", "required": ["type", "centerX", "amplitudeX", "periodMs", "enterY", "enterSpeed"], "properties": { "type": { "const": "sine" }, "centerX": { "type": "number" }, "amplitudeX": { "type": "number" }, "periodMs": { "type": "number", "exclusiveMinimum": 0 }, "enterY": { "type": "number" }, "enterSpeed": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "required": ["type", "x", "y"], "properties": { "type": { "const": "stationary" }, "x": { "type": "number" }, "y": { "type": "number" } } }
      ]
    },
    "formation": {
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["line", "v"] }, "spacing": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "required": ["type", "direction"], "properties": { "type": { "const": "sweep" }, "direction": { "enum": ["left", "right"] }, "spacing": { "type": "number", "exclusiveMinimum": 0 }, "stepY": { "type": "number" } } }
      ]
    },
    "stage": { "type": "object", "required": ["id", "name", "background", "width", "height", "waves"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "background": { "type": "string" }, "backgroundPresentation": { "type": "object", "required": ["fit"], "properties": { "fit": { "enum": ["cover", "stretch"] }, "focusX": { "type": "number", "minimum": 0, "maximum": 1 }, "focusY": { "type": "number", "minimum": 0, "maximum": 1 }, "alpha": { "type": "number", "minimum": 0, "maximum": 1 } } }, "width": { "type": "number" }, "height": { "type": "number" }, "bossId": { "type": "string" }, "waves": { "type": "array", "items": { "type": "object", "required": ["atMs", "enemy", "count", "formation"], "properties": { "atMs": { "type": "number", "minimum": 0 }, "enemy": { "type": "string" }, "count": { "type": "integer", "minimum": 1 }, "formation": { "$ref": "#/$defs/formation" } } } } } },
    "player": { "type": "object", "required": ["name", "texture", "speed", "focusSpeed", "shotLevels", "bomb"], "properties": { "name": { "type": "string" }, "texture": { "type": "string" }, "speed": { "type": "number" }, "focusSpeed": { "type": "number" }, "shotLevels": { "type": "array", "minItems": 1 }, "bomb": { "type": "object", "required": ["type", "invulnerabilityMs"], "properties": { "type": { "enum": ["clear-and-damage", "clear-only"] } } } } },
    "enemy": { "type": "object", "required": ["hp", "speed", "radius", "score", "color", "pickupChance", "patterns"], "properties": { "hp": { "type": "number", "exclusiveMinimum": 0 }, "movement": { "$ref": "#/$defs/movement" }, "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pattern" } } } },
    "boss": { "type": "object", "required": ["name", "texture", "radius", "spawn", "movement", "phases"], "properties": { "name": { "type": "string" }, "texture": { "type": "string" }, "movement": { "$ref": "#/$defs/movement" }, "phases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "hp", "durationMs", "patterns"], "properties": { "name": { "type": "string" }, "hp": { "type": "number", "exclusiveMinimum": 0 }, "durationMs": { "type": "number", "minimum": 1000 }, "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } } } } } } }
  }
}
