{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-rpg/game.schema.json",
  "title": "Data-driven SSG RPG Game Protocol v3",
  "type": "object",
  "required": [
    "protocolVersion",
    "game",
    "assets",
    "player",
    "combat",
    "items",
    "equipmentSlots",
    "skills",
    "effects",
    "monsters",
    "quests",
    "npcs",
    "shops",
    "currencies",
    "dialogues",
    "cutscenes",
    "chapters",
    "endings",
    "maps"
  ],
  "properties": {
    "protocolVersion": {
      "const": 3
    },
    "game": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "autosaveSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "autosaveSeconds": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "required": [
        "images",
        "spritesheets",
        "audio"
      ],
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string"
              }
            }
          }
        },
        "spritesheets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "src",
              "frameWidth",
              "frameHeight"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "frameWidth": {
                "type": "integer",
                "minimum": 1
              },
              "frameHeight": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "loop": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "name",
        "texture",
        "startMap",
        "startX",
        "startY",
        "baseStats",
        "xpCurve",
        "startingItems"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "texture": {
          "type": "string"
        },
        "portrait": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "startMap": {
          "type": "string"
        },
        "startX": {
          "type": "number"
        },
        "startY": {
          "type": "number"
        },
        "baseStats": {
          "$ref": "#/$defs/stats"
        },
        "levelGrowth": {
          "$ref": "#/$defs/stats"
        },
        "xpCurve": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2
        },
        "startingItems": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "combat": {
      "type": "object",
      "required": [
        "attackCooldownMs",
        "invulnerabilityMs",
        "attackRange"
      ],
      "properties": {
        "attackCooldownMs": {
          "type": "number",
          "minimum": 50
        },
        "invulnerabilityMs": {
          "type": "number",
          "minimum": 0
        },
        "attackRange": {
          "type": "number",
          "minimum": 1
        },
        "lootPickupRange": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description",
          "type",
          "maxStack",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": [
              "consumable",
              "quest",
              "material",
              "equipment"
            ]
          },
          "slot": { "type": "string" },
          "icon": { "type": "string" },
          "modifiers": { "type": "object", "properties": { "maxHp": { "type": "number" }, "attack": { "type": "number" }, "defense": { "type": "number" } } },
          "maxStack": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "actions": {
            "$ref": "#/$defs/actions"
          }
        }
      }
    },
    "equipmentSlots": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
    "skills": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "description", "cooldownMs", "range", "power", "target"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "icon": { "type": "string" }, "effect": { "enum": ["burst", "slash", "ring"] }, "effectColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "cooldownMs": { "type": "number", "minimum": 0 }, "range": { "type": "number", "minimum": 0 }, "power": { "type": "number" }, "target": { "enum": ["enemy", "self"] }, "actions": { "$ref": "#/$defs/actions" } } } },
    "effects": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "durationMs"], "properties": { "name": { "type": "string" }, "durationMs": { "type": "number", "minimum": 1 }, "tickMs": { "type": "number", "minimum": 1 }, "damagePerTick": { "type": "number" }, "healPerTick": { "type": "number" } } } },
    "monsters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "texture",
          "stats",
          "speed",
          "aggroRange",
          "xp",
          "drops"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "texture": { "type": "string" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "stats": {
            "$ref": "#/$defs/stats"
          },
          "speed": {
            "type": "number",
            "minimum": 0
          },
          "aggroRange": {
            "type": "number",
            "minimum": 0
          },
          "xp": {
            "type": "number",
            "minimum": 0
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "itemId",
                "chance",
                "min",
                "max"
              ],
              "properties": {
                "itemId": {
                  "type": "string"
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "quests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/quest"
      }
    },
    "npcs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "texture", "dialogue"],
        "properties": {
          "name": {
            "type": "string"
          },
          "texture": { "type": "string" },
          "portrait": { "type": "string" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "dialogue": {
            "type": "string"
          },
          "shop": { "type": "string" }
        }
      }
    },
    "currencies": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "symbol", "startingAmount"], "properties": { "name": { "type": "string" }, "symbol": { "type": "string" }, "startingAmount": { "type": "number" } } } },
    "shops": { "type": "object", "additionalProperties": { "type": "object", "required": ["name", "currency", "items"], "properties": { "name": { "type": "string" }, "currency": { "type": "string" }, "sellMultiplier": { "type": "number", "minimum": 0 }, "items": { "type": "array", "items": { "type": "object", "required": ["itemId", "buy"], "properties": { "itemId": { "type": "string" }, "buy": { "type": "number", "minimum": 0 }, "sell": { "type": "number", "minimum": 0 } } } } } } },
    "cutscenes": { "type": "object", "additionalProperties": { "type": "object", "required": ["steps"], "properties": { "steps": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["text", "wait", "camera", "action"] }, "text": { "type": "string" }, "durationMs": { "type": "number" }, "zoom": { "type": "number" }, "actions": { "$ref": "#/$defs/actions" } } } } } } },
    "chapters": { "type": "array", "items": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } } } } },
    "endings": { "type": "object", "additionalProperties": { "type": "object", "required": ["title", "text"], "properties": { "title": { "type": "string" }, "text": { "type": "array", "items": { "type": "string" } }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } } } } },
    "dialogues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/dialogueNode"
        }
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/map"
      }
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "required": [
        "maxHp",
        "attack",
        "defense"
      ],
      "properties": {
        "maxHp": {
          "type": "number",
          "minimum": 1
        },
        "attack": {
          "type": "number",
          "minimum": 0
        },
        "defense": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "type",
        "id",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "questStatus",
            "objective",
            "level",
            "hasItem",
            "flag",
            "currency",
            "equipped",
            "chapter"
          ]
        },
        "id": {
          "type": "string"
        },
        "value": {},
        "operator": {
          "enum": [
            "eq",
            "gte",
            "lte"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "startQuest",
            "completeQuest",
            "failQuest",
            "objective",
            "giveItem",
            "takeItem",
            "heal",
            "setFlag",
            "xp",
            "teleport",
            "currency",
            "learnSkill",
            "effect",
            "cutscene",
            "chapter",
            "ending"
          ]
        },
        "id": {
          "type": "string"
        },
        "objectiveId": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "value": {
          "type": "boolean"
        },
        "mapId": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "dialogueNode": {
      "type": "object",
      "required": [
        "id",
        "speaker",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "portrait": { "type": "string" },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "actions": {
          "$ref": "#/$defs/actions"
        },
        "next": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "next": {
                "type": "string"
              },
              "actions": {
                "$ref": "#/$defs/actions"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              }
            }
          }
        }
      }
    },
    "quest": {
      "type": "object",
      "required": [
        "title",
        "giver",
        "summary",
        "objectives",
        "rewards",
        "success",
        "failure"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "giver": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type",
              "target",
              "targetId"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "kill",
                  "talk",
                  "visit",
                  "collect",
                  "custom"
                ]
              },
              "target": {
                "type": "integer",
                "minimum": 1
              },
              "targetId": {
                "type": "string"
              }
            }
          }
        },
        "rewards": {
          "type": "object",
          "properties": {
            "xp": {
              "type": "number",
              "minimum": 0
            },
            "items": {
              "$ref": "#/$defs/countMap"
            }
          }
        },
        "success": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "name",
        "subtitle",
        "grid",
        "ground",
        "path",
        "spawn",
        "npcs",
        "exits",
        "spawns"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "ground": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pathOverlay": {
          "type": "boolean"
        },
        "grid": { "$ref": "#/$defs/point" },
        "backgroundImage": { "type": "string" },
        "backgroundAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "music": { "type": "string" },
        "spawn": {
          "$ref": "#/$defs/point"
        },
        "walkableAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "points"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
            }
          }
        },
        "npcs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "npcId",
              "x",
              "y"
            ],
            "properties": {
              "npcId": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "route": {
                "type": "array",
                "items": { "$ref": "#/$defs/point" }
              },
              "routeDurationMs": {
                "type": "number",
                "minimum": 250
              }
            }
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height",
              "direction",
              "to",
              "label"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "direction": { "enum": ["north", "east", "south", "west"] },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "targetX": {
                "type": "number"
              },
              "targetY": {
                "type": "number"
              }
            }
          }
        },
        "spawns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "monsterId",
              "x",
              "y",
              "width",
              "height",
              "max",
              "respawnMs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "monsterId": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "respawnMs": {
                "type": "number",
                "minimum": 500
              }
            }
          }
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
