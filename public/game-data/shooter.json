  "dialogues": {
    "opening": [
      { "speaker": "여행자", "text": "저 너머에서 별빛이 흔들리고 있어. 봉인이 무너지기 전에 유적으로 가야 해.", "portrait": "hero_portrait", "side": "left" },
      { "speaker": "???", "text": "돌아가라. 오늘 밤의 유적은 누구도 들이지 않는다.", "side": "right" },
      { "speaker": "여행자", "text": "목소리의 주인을 만나려면, 이 탄막부터 돌파해야겠네.", "portrait": "hero_portrait", "side": "left" }
    ],
    "stage_one_clear": [
      { "speaker": "여행자", "text": "초원의 요정들은 물러났어. 별빛의 근원은 바로 앞이야.", "portrait": "hero_portrait", "side": "left" }
    ],
    "ruins_arrival": [
      { "speaker": "여행자", "text": "여기가 별빛 유적… 공기 속에 탄막의 술식이 가득해.", "portrait": "hero_portrait", "side": "left" },
      { "speaker": "???", "text": "마지막 경고다. 수호자의 영역에서 떠나라.", "side": "right" }
    ],
    "boss_encounter": [
      { "speaker": "셀레네", "text": "나는 성좌의 파수꾼 셀레네. 별의 문을 탐하는 자를 시험한다.", "portrait": "boss_portrait", "side": "right" },
      { "speaker": "여행자", "text": "문을 훔치러 온 게 아니야. 폭주하는 별빛을 멈추러 왔어.", "portrait": "hero_portrait", "side": "left" },
      { "speaker": "셀레네", "text": "그 말이 진실이라면 네 탄막으로 증명해라. 간다—성부 「쌍성의 윤무」!", "portrait": "boss_portrait", "side": "right" }
    ],
    "ending": [
      { "speaker": "셀레네", "text": "훌륭하다. 네 빛이라면 별의 문을 맡길 수 있겠군.", "portrait": "boss_portrait", "side": "right" },
      { "speaker": "여행자", "text": "이제 시작이야. 문 너머에서 무엇이 기다리는지 확인하러 가자.", "portrait": "hero_portrait", "side": "left" }
    ]
